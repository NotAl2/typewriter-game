lines = PackedStringArray("Mr Barrow,", "", "The ledger you ask", "after is safe in my", "hands and shall stay", "so until the 14th.", "", "I have entered the", "sums for March and", "April; there is a", "shortfall of 3s 6d", "which I cannot yet", "account for.", "", "J. Hallow")
