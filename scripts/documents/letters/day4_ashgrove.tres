notes = "Day four. The impossible address appears here as CONTENT to be typed - but the envelope is pre-printed, so it is never a typing trap."
lines = PackedStringArray("Dear Mrs Ashe,", "", "You asked me twice", "and I will answer", "once. There is no", "house at 14 Ashgrove", "Lane. There is no", "Ashgrove Lane.", "", "I have walked it,", "and I have the map", "before me now.", "", "Stop writing to that", "address.", "J. Hallow")
