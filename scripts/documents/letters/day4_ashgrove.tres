script = ExtResource("1_docdata")
title = "Ashgrove Lane"
sender = "J. Hallow"
recipient = "Mrs Eleanor Ashe"
address = PackedStringArray("Mrs Eleanor Ashe", "The Old Vicarage", "Wren Hollow")
